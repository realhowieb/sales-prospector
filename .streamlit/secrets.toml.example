# Copy this to `.streamlit/secrets.toml` for local dev, and paste the same block
# into Streamlit Cloud → your app → Settings → Secrets for the deployed app.
# The real secrets.toml is gitignored — never commit your keys.

[supabase]
# Project URL and the ANON (public) key from:
# Supabase dashboard → Project Settings → API
url = "https://YOUR-PROJECT-REF.supabase.co"
key = "YOUR-ANON-PUBLIC-KEY"
# Required for private server/admin workflows: the SERVICE_ROLE key (also under
# Project Settings → API). New profile/opportunity creation uses signed-in
# Supabase users and RLS; the service key is still used server-side for lead
# capture, verified reviews, moderation, legacy listing management, and pipeline
# sync. Keep it server-side only (Streamlit secrets never reach the browser).
service_key = "YOUR-SERVICE-ROLE-KEY"

[app]
# Public deployed URL used to build one-time verified review links.
base_url = "https://YOUR-STREAMLIT-APP-URL"

[admin]
# Optional: SHA-256 hash of an admin code for the in-app moderation panel.
# Generate with: python3 -c 'import hashlib; print(hashlib.sha256(b"YOUR-CODE").hexdigest())'
code_hash = "SHA256-OF-YOUR-ADMIN-CODE"

[monetization]
# Keep false while developing/testing so all features remain available. Set true
# later when subscription plans should actively restrict UI capabilities.
enforce_entitlements = false

# Optional: rep lead notifications by email, via Resend over SMTP.
# Only `password` (your Resend API key, re_...) and `from` (an address on a
# verified Resend domain, e.g. leads@hsfinest.ai) are required.
[smtp]
password = "re_YOUR_RESEND_API_KEY"
from = "leads@hsfinest.ai"
# host = "smtp.resend.com"   # defaults shown; override only if needed
# port = 587
# user = "resend"
