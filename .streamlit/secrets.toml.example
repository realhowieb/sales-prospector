# Copy this to `.streamlit/secrets.toml` for local dev, and paste the same block
# into Streamlit Cloud → your app → Settings → Secrets for the deployed app.
# The real secrets.toml is gitignored — never commit your keys.

[supabase]
# Project URL and the ANON (public) key from:
# Supabase dashboard → Project Settings → API
url = "https://YOUR-PROJECT-REF.supabase.co"
key = "YOUR-ANON-PUBLIC-KEY"
