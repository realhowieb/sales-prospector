# Copy to .env.local for local dev. On Render, set these as environment variables on the static site.
# The anon key is public by design (row-level security protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
NEXT_PUBLIC_API_URL=https://api.firstknock.hsfinest.com
